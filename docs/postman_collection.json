{
  "info": {
    "name": "Django React JWT Auth",
    "description": "Registration, OTP verification, login, JWT cookie auth, profile, refresh, logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPass123\",\n  \"confirm_password\": \"StrongPass123\"\n}"
        },
        "url": { "raw": "{{base_url}}/register/", "host": ["{{base_url}}"], "path": ["register", ""] }
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jane@example.com\",\n  \"otp\": \"123456\"\n}"
        },
        "url": { "raw": "{{base_url}}/verify-otp/", "host": ["{{base_url}}"], "path": ["verify-otp", ""] }
      }
    },
    {
      "name": "Resend OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jane@example.com\"\n}"
        },
        "url": { "raw": "{{base_url}}/resend-otp/", "host": ["{{base_url}}"], "path": ["resend-otp", ""] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPass123\"\n}"
        },
        "url": { "raw": "{{base_url}}/login/", "host": ["{{base_url}}"], "path": ["login", ""] },
        "description": "Sets access_token and refresh_token HTTP-only cookies. Enable Postman's cookie jar to persist them for subsequent requests."
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/token/refresh/", "host": ["{{base_url}}"], "path": ["token", "refresh", ""] }
      }
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/profile/", "host": ["{{base_url}}"], "path": ["profile", ""] }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/logout/", "host": ["{{base_url}}"], "path": ["logout", ""] }
      }
    }
  ]
}
